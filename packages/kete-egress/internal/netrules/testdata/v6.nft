# Generated by kete-egress nft (config v1). Apply as root: kete-egress nft --config <file> | nft -f -
table inet kete_egress
delete table inet kete_egress

table inet kete_egress {
	set blocked_v4 {
		type ipv4_addr
		flags interval
		elements = { 0.0.0.0/8, 10.0.0.0/8, 100.64.0.0/10, 127.0.0.0/8, 169.254.0.0/16, 172.16.0.0/12, 192.0.0.0/24, 192.168.0.0/16, 198.18.0.0/15, 224.0.0.0/3 }
	}

	set blocked_v6 {
		type ipv6_addr
		flags interval
		elements = { ::/96, ::ffff:0.0.0.0/96, 64:ff9b::/96, 64:ff9b:1::/48, 100::/64, 2002::/16, fc00::/7, fe80::/10, ff00::/8 }
	}

	chain output {
		type filter hook output priority -155; policy drop;
		ct state established,related accept
		ct state invalid drop
		icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-solicit, mld2-listener-report } accept
		meta skuid 990 jump proxy_out
		meta skuid 991 jump kete_out
		meta skuid 992 jump tool_out
		meta skuid 0 jump root_out
		jump refuse
	}

	chain refuse {
		meta l4proto tcp reject with tcp reset
		reject with icmpx port-unreachable
	}

	chain proxy_out {
		ip6 daddr { fdaa::3 } meta l4proto { udp, tcp } th dport 53 accept
		ip daddr @blocked_v4 jump refuse
		ip6 daddr @blocked_v6 jump refuse
		tcp dport 443 accept
	}

	chain kete_out {
		ip daddr 127.0.0.1 tcp dport 81 accept
	}

	chain tool_out {
		ip daddr 127.0.0.1 tcp dport 82 accept
		ip daddr 127.0.0.0/8 meta l4proto { tcp, udp } th dport >= 1024 accept
		ip6 daddr ::1 meta l4proto { tcp, udp } th dport >= 1024 accept
	}

	chain root_out {
		ip daddr 127.0.0.1 tcp dport 83 accept
	}

	chain input {
		type filter hook input priority filter; policy drop;
		ct state established,related accept
		ct state invalid drop
		iifname "lo" accept
		icmpv6 type { nd-neighbor-solicit, nd-neighbor-advert, nd-router-advert, packet-too-big } accept
