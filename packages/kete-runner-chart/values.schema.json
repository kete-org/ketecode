{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "platform",
    "image",
    "jobs",
    "boundary",
    "podDriver"
  ],
  "properties": {
    "platform": {
      "type": "object",
      "required": [
        "url"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^(https://[a-z0-9.-]+(:443)?/?)?$"
        }
      },
      "additionalProperties": false
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^([a-z0-9.:-]+/[a-z0-9._/-]+)?$"
        },
        "digest": {
          "type": "string",
          "pattern": "^(sha256:[0-9a-f]{64})?$"
        },
        "pullPolicy": {
          "enum": [
            "IfNotPresent",
            "Always",
            "Never"
          ]
        }
      },
      "additionalProperties": false
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "enrollment": {
      "type": "object",
      "properties": {
        "tokenSecret": {
          "type": "string",
          "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*)?$"
        }
      },
      "additionalProperties": false
    },
    "proxy": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^(https?://[A-Za-z0-9.-]+(:[0-9]{1,5})?/?)?$"
        },
        "authSecret": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*)?$"
            },
            "key": {
              "type": "string",
              "pattern": "^[-._a-zA-Z0-9]+$"
            }
          }
        },
        "noProxy": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "pattern": "^\\.?([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]([a-z0-9-]{0,61}[a-z0-9])?$"
          }
        }
      },
      "additionalProperties": false
    },
    "caBundle": {
      "type": "object",
      "properties": {
        "existingSecret": {
          "type": "string",
          "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*)?$"
        },
        "key": {
          "type": "string",
          "pattern": "^[-._a-zA-Z0-9]+$"
        }
      },
      "additionalProperties": false
    },
    "jobs": {
      "type": "object",
      "properties": {
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
        },
        "createNamespace": {
          "type": "boolean"
        },
        "runtimeClassNames": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "not": {
              "enum": [
                "runc",
                "runsc",
                "gvisor"
              ]
            }
          }
        },
        "images": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9.:-]+/[a-z0-9._/-]+@sha256:[0-9a-f]{64}$"
          }
        },
        "slots": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "startTimeoutSeconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 3600
        },
        "allowedCapabilities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "NET_ADMIN",
              "SYS_ADMIN",
              "SYS_RESOURCE",
              "SETUID",
              "SETGID",
              "KILL",
              "CHOWN",
              "DAC_OVERRIDE",
              "FOWNER",
              "FSETID",
              "NET_BIND_SERVICE"
            ]
          }
        },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cidrs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$|^[0-9a-fA-F:]+/([0-9]|[1-9][0-9]|1[01][0-9]|12[0-8])$",
                "not": {
                  "enum": [
                    "0.0.0.0/0",
                    "::/0"
                  ]
                }
              }
            },
            "ports": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            }
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cpu",
            "memory",
            "ephemeralStorage"
          ],
          "properties": {
            "cpu": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|M|G|T|Ki|Mi|Gi|Ti)?$"
            },
            "memory": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|M|G|T|Ki|Mi|Gi|Ti)?$"
            },
            "ephemeralStorage": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|M|G|T|Ki|Mi|Gi|Ti)?$"
            }
          }
        },
        "outbox": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "size": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|M|G|T|Ki|Mi|Gi|Ti)?$"
            },
            "storageClass": {
              "type": "string",
              "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*)?$"
            },
            "holdHours": {
              "type": "integer",
              "minimum": 1,
              "maximum": 720
            },
            "maxSize": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?(m|k|M|G|T|Ki|Mi|Gi|Ti)?$"
            },
            "accessMode": {
              "enum": [
                "ReadWriteOncePod",
                "ReadWriteOnce"
              ]
            }
          }
        },
        "proxy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "authSecret": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*)?$"
                },
                "key": {
                  "type": "string",
                  "pattern": "^[-._a-zA-Z0-9]+$"
                }
              }
            }
          }
        }
      },
      "additionalProperties": false
    },
    "repositories": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{0,19}:[A-Za-z0-9_][A-Za-z0-9._-]*(/[A-Za-z0-9_][A-Za-z0-9._-]*)*$"
      }
    },
    "repositorySources": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "url"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,19}:[A-Za-z0-9_][A-Za-z0-9._-]*(/[A-Za-z0-9_][A-Za-z0-9._-]*)*$"
          },
          "url": {
            "type": "string",
            "pattern": "^https://[a-z0-9.-]+(:[1-9][0-9]{0,4})?/[^?#@ ]+$"
          },
          "cloneSecret": {
            "type": "string",
            "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*)?$"
          },
          "apiURL": {
            "type": "string",
            "pattern": "^(https://[a-z0-9.-]+(:[1-9][0-9]{0,4})?(/[^?#@ ]*[^/?#@ ])?)?$"
          },
          "cloneMode": {
            "type": "string",
            "enum": [
              "",
              "static",
              "minted"
            ]
          },
          "minterSecret": {
            "type": "string",
            "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*)?$"
          },
          "writerSecret": {
            "type": "string",
            "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*)?$"
          },
          "writerUsername": {
            "type": "string",
            "pattern": "^([A-Za-z0-9_.-]{1,128})?$"
          }
        }
      }
    },
    "advertiseRepositories": {
      "type": "boolean"
    },
    "boundary": {
      "type": "object",
      "properties": {
        "summary": {
          "enum": [
            "none",
            "redacted",
            "full"
          ]
        },
        "denials": {
          "enum": [
            "count",
            "actions",
            "full"
          ]
        },
        "publishRefs": {
          "enum": [
            "omit",
            "send"
          ]
        }
      },
      "additionalProperties": false
    },
    "podDriver": {
      "enum": [
        "kubevm",
        "placeholder"
      ]
    },
    "placeholder": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exitAfter": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "image",
              "seconds"
            ],
            "properties": {
              "image": {
                "type": "string"
              },
              "seconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 86400
              }
            }
          }
        }
      }
    },
    "controller": {
      "type": "object",
      "properties": {
        "serviceAccountName": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
        },
        "leaseName": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
        },
        "keysSecret": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
        },
        "stateSecret": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
        },
        "resources": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        },
        "podAnnotations": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "apiServer": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cidrs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$|^[0-9a-fA-F:]+/([0-9]|[1-9][0-9]|1[01][0-9]|12[0-8])$"
              }
            },
            "port": {
              "type": "integer",
              "minimum": 1,
              "maximum": 65535
            }
          }
        },
        "platform": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cidrs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$|^[0-9a-fA-F:]+/([0-9]|[1-9][0-9]|1[01][0-9]|12[0-8])$"
              }
            },
            "ports": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            }
          }
        },
        "dns": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "namespace": {
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?$"
            },
            "podLabels": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "pattern": "^[-._a-zA-Z0-9]{0,63}$"
              }
            }
          }
        },
        "repositories": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cidrs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$|^[0-9a-fA-F:]+/([0-9]|[1-9][0-9]|1[01][0-9]|12[0-8])$"
              }
            },
            "ports": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            }
          }
        }
      }
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cpu": {
              "type": [
                "string",
                "number"
              ]
            },
            "memory": {
              "type": "string"
            }
          }
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 3600
        },
        "commitIdentity": {
          "type": "string",
          "pattern": "^([^<>\\n]+ <[^<>\\s]+>)?$",
          "maxLength": 200
        },
        "ciOnJobBranches": {
          "type": "boolean"
        },
        "caBundleSecret": {
          "type": "string",
          "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*)?$"
        },
        "proxyAuthSecret": {
          "type": "string",
          "pattern": "^([a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*)?$"
        },
        "egress": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cidrs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^([0-9]{1,3}\\.){3}[0-9]{1,3}/([0-9]|[12][0-9]|3[0-2])$|^[0-9a-fA-F:]+/([0-9]|[1-9][0-9]|1[01][0-9]|12[0-8])$"
              }
            },
            "ports": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            }
          }
        }
      }
    }
  },
  "additionalProperties": false
}
