{
  "boot-source": {
    "kernel_image_path": "/vmlinux",
    "boot_args": "console=ttyS0 reboot=k panic=1 pci=off quiet loglevel=1 init=/usr/local/libexec/kete/kete-job-init ip=10.200.0.10::10.200.0.9:255.255.255.252::eth0:off:1.1.1.1:8.8.8.8"
  },
  "drives": [
    {
      "drive_id": "rootfs",
      "path_on_host": "/rootfs.ext4",
      "is_root_device": true,
      "is_read_only": true,
      "rate_limiter": {
        "bandwidth": {
          "size": 419430400,
          "refill_time": 1000
        },
        "ops": {
          "size": 10000,
          "refill_time": 1000
        }
      }
    },
    {
      "drive_id": "scratch",
      "path_on_host": "/scratch.ext4",
      "is_root_device": false,
      "is_read_only": false,
      "rate_limiter": {
        "bandwidth": {
          "size": 419430400,
          "refill_time": 1000
        },
        "ops": {
          "size": 10000,
          "refill_time": 1000
        }
      }
    },
    {
      "drive_id": "config",
      "path_on_host": "/cfg/config.img",
      "is_root_device": false,
      "is_read_only": true
    }
  ],
  "machine-config": {
    "vcpu_count": 4,
    "mem_size_mib": 4096,
    "smt": false
  },
  "network-interfaces": [
    {
      "iface_id": "eth0",
      "host_dev_name": "kjh2",
      "guest_mac": "06:00:0a:c8:00:0a",
      "rx_rate_limiter": {
        "bandwidth": {
          "size": 125000000,
          "refill_time": 1000
        }
      },
      "tx_rate_limiter": {
        "bandwidth": {
          "size": 125000000,
          "refill_time": 1000
        }
      }
    }
  ],
  "logger": {
    "log_path": "/firecracker.log",
    "level": "Info"
  }
}
