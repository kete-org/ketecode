// Work mode: delegated knowledge work outside a repository.
// Embedded in the binary and decoded strictly by core/src/kete/modes.ts (schema/src/kete/modes.ts);
// not user-editable. Its skills live in kete-loom, not this repository.
{
  "id": "work",
  "name": "Work",
  "description": "Delegate knowledge work: files you grant, a few safe tools, approvals by action.",
  "agent": "work-orchestrator",
  // Enforced since WS1 1.3 (core/src/kete/work-mode.ts); not available until WS1 1.4 adds the agent.
  "available": false,
  "files": "granted",
  "shell": { "run": "allowlist", "allow": ["python", "python3", "node"], "windows": "off" },
  "network": "off",
  "git": false,
  "web": true,
  "mcp": false,
  "approvals": "action-class",
  "outputs": "kete-outputs"
}
