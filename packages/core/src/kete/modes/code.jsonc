// Code mode: Kete Code as it works today, for software engineering in a repository.
// Embedded in the binary and decoded strictly by core/src/kete/modes.ts (schema/src/kete/modes.ts);
// not user-editable. The fields describe the mode; nothing enforces them yet (WS1 1.3).
{
  "id": "code",
  "name": "Code",
  "description": "Build, test and review code in a repository.",
  // The agent a new session starts with (core/src/agent.ts `defaultID`).
  "agent": "build",
  "available": true,
  "files": "workspace",
  "shell": { "run": "any", "allow": [], "windows": "same" },
  "network": "default",
  "git": true,
  "web": true,
  "mcp": true,
  "approvals": "default",
  "outputs": "in-place"
}
